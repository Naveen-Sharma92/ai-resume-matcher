# ---------- runtime ----------
NODE_ENV=development
PORT=8000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

# ---------- postgres (Supabase in prod) ----------
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_matcher
DATABASE_SSL=false

# ---------- auth ----------
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change-me-refresh-secret
REFRESH_TOKEN_EXPIRY=7d

# ---------- redis (Upstash in prod: rediss://default:<pw>@<host>:6379) ----------
REDIS_URL=redis://localhost:6379
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=30

# ---------- kafka (Redpanda locally, Aiven free tier in prod) ----------
KAFKA_CLIENT_ID=api-service
KAFKA_BROKERS=localhost:19092
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
# Aiven gives you a ca.pem - paste it base64-encoded on one line:
#   base64 -w0 ca.pem
KAFKA_CA_CERT_B64=

# ---------- object storage ----------
# Leave S3_ENDPOINT empty for real AWS S3. Point it at any S3-compatible mock
# for local development (docker-compose starts one on http://localhost:9090).
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ai-resume-matcher-dev
S3_PRESIGN_EXPIRY_SECONDS=900

# ---------- runtime ----------
NODE_ENV=development
LOG_LEVEL=debug
# Render's free plan has no Background Workers, so this service also exposes a
# tiny HTTP health server and is deployed as a *web service*.
PORT=8080

# ---------- postgres (Supabase in prod) ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resume_matcher
DATABASE_SSL=false

# ---------- redis (Upstash in prod) ----------
REDIS_URL=redis://localhost:6379
EMBEDDING_CACHE_TTL_SECONDS=2592000

# ---------- kafka (Redpanda locally, Aiven free tier in prod) ----------
KAFKA_CLIENT_ID=worker-service
KAFKA_BROKERS=localhost:19092
KAFKA_GROUP_ID=match-worker-group
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_CERT_B64=

# ---------- object storage ----------
# Empty = real AWS S3. Point at an S3-compatible mock for local development.
S3_ENDPOINT=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ai-resume-matcher-dev

# ---------- gemini (free tier) ----------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Check https://ai.google.dev/gemini-api/docs/models for the current free-tier ids.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must equal the vector(...) size in db/migrations/001_init.sql
GEMINI_EMBEDDING_DIM=768
GEMINI_MAX_RETRIES=4
GEMINI_TIMEOUT_MS=60000

# ---------- processing ----------
MAX_ATTEMPTS=3
MAX_RESUME_CHARS=60000

# Root .env - consumed by docker-compose only.
# Each service also has its own .env.sample for running outside Docker.

# ---------- the only value you must fill in ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (see https://ai.google.dev/gemini-api/docs/models)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# JWT secrets for local dev
ACCESS_TOKEN_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me

# ---------- storage ----------
# Local dev uses the S3 mock container from docker-compose, so no AWS account
# is needed to run the stack. Leave these alone unless you want real S3, in which
# case set S3_ENDPOINT= (empty) and fill in real credentials.
S3_ENDPOINT=http://s3mock:9090
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev
S3_BUCKET=resumes-dev
